echo "🎨 Running Prettier formatting..."
pnpm format:fix

echo "🔄 Linting..."
pnpm lint:fix

if ! git diff --exit-code --quiet; then
  echo "📝 Auto-staging formatting changes..."
  git add .
fi

echo "🔎 Typechecking..."
pnpm typecheck

echo "🔄 Building..."
pnpm build

echo "🧪 Running tests..."
pnpm test
