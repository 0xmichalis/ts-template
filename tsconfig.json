{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "resolveJsonModule": true,
    "types": ["node", "mocha"],
    "skipLibCheck": false,
    "allowJs": false,
    "noEmit": true
  },
  "include": ["src", "test"]
}
