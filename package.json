{
  "name": "ts-template",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Michalis Kargakis",
  "type": "module",
  "scripts": {
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json && pnpm run copy",
    "clean": "rm -rf ./node_modules ./dist",
    "copy": "cp ./package.json ./pnpm-lock.yaml ./dist",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "prepare": "husky",
    "start": "pnpm build && node ./dist/main.js",
    "test": "mocha --import=tsx \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "chai": "^6.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "mocha": "^11.8.0",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  }
}
